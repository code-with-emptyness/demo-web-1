# Frontend Environment Variables

# Backend API Base URL
# For local development: http://localhost:5000
# For production (e.g., Render/Railway/Vercel Backend): https://your-backend-domain.com
# For unified domain hosting with reverse proxy: leave blank or use /api
VITE_API_BASE_URL=http://localhost:5000

# Application branding
VITE_APP_NAME="Demo Store"
